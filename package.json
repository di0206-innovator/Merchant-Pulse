{
  "name": "merchantpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:eval": "vitest run tests/evaluation",
    "test:stress": "vitest run tests/stress",
    "benchmark": "npx tsx scripts/runBenchmark.ts",
    "benchmark:heldout": "npx tsx scripts/runBenchmark.ts --size=1000 --seed=20260825",
    "benchmark:safety": "vitest run tests/evaluation/batch/safety-benchmark.test.ts",
    "benchmark:report": "npx tsx scripts/runBenchmark.ts --size=5000"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
