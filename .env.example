# MerchantPulse Environment Variables

# App Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay API Credentials (Test or Live)
# For local demo mode, deterministic mocks are used if these are omitted.
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Google Gemini API Key (@google/genai)
# For local demo mode, MockStrategyProvider is available if this is omitted.
GEMINI_API_KEY=YourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Policy Defaults
DEFAULT_MAX_AUTO_GMV_INR=25000
DEFAULT_MIN_EV_INR=20
CONTACT_COOLDOWN_HOURS=24

# Supabase Auth & Database Credentials
NEXT_PUBLIC_SUPABASE_URL=https://ttxbgdosrtohcksvydsc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YourSupabaseAnonKeyHere

