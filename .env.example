# MerchantPulse Environment Variables

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay API Credentials (Test or Live)
# Server-side credentials (NEVER expose to the browser)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Frontend Razorpay Key (Publicly safe key ID for standard checkout popup)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Google Gemini API Key (@google/genai)
# Server-side credential for LLM strategy reasoning and customer copy
GEMINI_API_KEY=YourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Policy Engine Defaults (Guardrails)
DEFAULT_MAX_AUTO_GMV_INR=25000
DEFAULT_MIN_EV_INR=20
CONTACT_COOLDOWN_HOURS=24

# Supabase Auth & Database (PostgreSQL Persistence)
# Public credentials (Safe for browser authentication & client reads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only service role credential (for backend ledger writes & webhook ingestion)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
