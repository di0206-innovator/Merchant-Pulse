# MerchantPulse Environment Variables Configuration
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local with real production credentials.

# Google Gemini API (Backend Strategy Intelligence)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay API Credentials (Backend Only - Webhook & Orders)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Admin Control Room Access & Session Token
# In production, use a strong 32+ character passphrase
ADMIN_ACCESS_PASSWORD=admin_demo_secure_pass_2026
ADMIN_SESSION_SECRET=merchantpulse_secure_session_secret_change_me_in_prod

# Application Base URL (Strict CORS & Canonical Metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security Settings
NODE_ENV=development
